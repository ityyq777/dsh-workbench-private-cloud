# 私人云端访问密钥，至少 16 位，必须自己生成（例如 openssl rand -hex 32）。
WB_PRIVATE_SECRET=请替换为随机长密钥

# 监听地址与端口。
WB_PRIVATE_BIND=0.0.0.0
WB_PRIVATE_PORT=8792

# 数据目录：SQLite 数据库与 blob 文件都在这里。
WB_PRIVATE_DATA=./data

# 在宿主里显示的云端名称。
WB_PRIVATE_SERVER_NAME=我的私人云端

# 单文件上限与总配额（字节）。默认 200 MB / 20 GB。
WB_PRIVATE_MAX_FILE_BYTES=209715200
WB_PRIVATE_QUOTA_BYTES=21474836480

# 同步会话有效期（秒），允许范围 10..600。
WB_PRIVATE_SESSION_TTL_SECONDS=300

# 只有在 HTTPS 反向代理之后才设为 1，用于取 x-forwarded-for 作为客户端 IP。
WB_PRIVATE_TRUST_PROXY=0
