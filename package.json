{
  "name": "dsh-workbench-private-cloud",
  "version": "0.2.0",
  "description": "DSH Workbench 私人云端：单用户、多设备数据同步（协议 v2），零依赖 Node.js 服务",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "wb-private-cloud": "bin/wb-private-cloud.mjs"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:cli": "node bin/wb-private-cloud.mjs start",
    "stop": "node bin/wb-private-cloud.mjs stop",
    "status": "node bin/wb-private-cloud.mjs status",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "files": [
    "bin",
    "src",
    "README.md",
    "Dockerfile",
    "docker-compose.yml",
    ".env.example"
  ]
}
